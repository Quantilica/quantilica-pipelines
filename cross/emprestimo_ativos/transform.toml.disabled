# Mart de empréstimo de ativos (BTC): short interest por ticker e dia.
# Lê as views do Lake; nada de microdado identificável no PostgreSQL.

prelude = "prelude.sql"

[[table]]
name        = "fato_short_interest_b3"
schema      = "marts"
strategy    = "replace"
engine      = "duckdb"
sql         = "transform.sql"
description = "Short interest diário por ticker: posição alugada, volume, taxa média e razão sobre o volume negociado"
primary_key = ["data", "simbolo"]
indexes = [
    { name = "idx_fato_short_interest_b3_simbolo", columns = ["simbolo"] },
    { name = "idx_fato_short_interest_b3_data", columns = ["data"] },
]
